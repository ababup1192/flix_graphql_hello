{
  "name": "cms-admin-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "gen": "elm-graphql --schema-file ../admin.graphql --base Api.Admin --output generated --scalar-codecs ScalarCodecs && elm-graphql --schema-file ../account.graphql --base Api.Account --output generated --scalar-codecs AccountCodecs",
    "test": "elm-test",
    "check": "node scripts/wording-check.mjs && node scripts/gen-check.mjs && node scripts/fallback-check.mjs && node scripts/utc-check.mjs && node scripts/editor-check.mjs && elm-format --validate src tests && elm-review && elm-test && elm make src/Main.elm --output=/dev/null && tsc --noEmit && npm run checks",
    "review": "elm-review",
    "contract": "node scripts/contract.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run check && npm run contract && npm run smoke && npm run audit",
    "seed": "node scripts/seed.mjs",
    "explore": "node scripts/explore.mjs",
    "audit": "node scripts/audit.mjs && node scripts/audit2.mjs",
    "checks": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@dillonkearns/elm-graphql": "^4.3.2",
    "@types/node": "^22.20.2",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "elm": "^0.19.2-0",
    "elm-format": "^0.8.8",
    "elm-review": "^2.13.5",
    "elm-test": "^0.19.2-1",
    "highlight.js": "^11.12.0",
    "playwright": "^1.49.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-elm": "3.0.1",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-blockquote": "^3.31.3",
    "@tiptap/extension-bubble-menu": "^3.31.3",
    "@tiptap/extension-code": "^3.31.3",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "katex": "^0.18.7",
    "lowlight": "^3.3.0",
    "mermaid": "^11.17.2",
    "tailwindcss": "^4.3.3"
  }
}
