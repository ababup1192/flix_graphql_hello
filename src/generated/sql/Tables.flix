    ///
    pub enum Constraint with Eq, Order, ToString {
        /// webhook_deliveries_status_check (check)
        case StatusCheck
        /// webhook_deliveries_project_id_fkey (foreign key)
        case ProjectIdFkey
        /// webhook_deliveries_webhook_id_fkey (foreign key)
        case WebhookIdFkey
    }

    ///
    /// このテーブルへの書き込みを、制約違反を `translate` で翻訳しながら実行する。
    /// translate は thunk と同じ型の値を返すか、業務エラーのエフェクトを投げる。翻訳しない case は `raiseConstraint`。
    /// enum に無い名前の違反と、制約違反以外の DbErr はそのまま上へ。Tx の外で呼ぶ（違反で abort した Tx に COMMIT を出さない）。
    ///
    pub def onConstraint(translate: Constraint -> a \ ef1, thunk: Unit -> a \ ef2): a \ ef1 + ef2 + {TransientDbErr, DbErr} =
        DbError.onConstraintWith(constraintOf, translate, thunk)

    ///
    /// 翻訳しない制約を元の DbErr に戻す。`onConstraint` に渡す関数の中で使う。
    ///
    pub def raiseConstraint(constraint: Constraint): a \ DbErr = match constraint {
        case Constraint.StatusCheck => DbErr.checkViolation("webhook_deliveries_status_check")
        case Constraint.ProjectIdFkey => DbErr.foreignKeyViolation("webhook_deliveries_project_id_fkey")
        case Constraint.WebhookIdFkey => DbErr.foreignKeyViolation("webhook_deliveries_webhook_id_fkey")
    }

    def constraintOf(name: String): Option[Constraint] = match name {
        case "webhook_deliveries_status_check" => Some(Constraint.StatusCheck)
        case "webhook_deliveries_project_id_fkey" => Some(Constraint.ProjectIdFkey)
        case "webhook_deliveries_webhook_id_fkey" => Some(Constraint.WebhookIdFkey)
