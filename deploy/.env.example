# cp .env.example .env にして値を入れる。.env は git に入れない。
# Doppler や 1Password から流し込む時も、この名前で環境変数を渡せば同じ（compose は .env 以外の環境変数も読む）。

# イメージ。タグは GitHub Actions が付ける git の sha か、latest
CMS_IMAGE=ghcr.io/ababup1192/flix_graphql_hello:latest

# PostgreSQL
POSTGRES_DB=cms
POSTGRES_USER=cms
POSTGRES_PASSWORD=change-me
# リクエスト用のロール（RLS が効き、DDL できない）。起動時に所有者が作る。空なら所有者で繋ぐ（policy は効くがロール分離は無し）
CMS_DB_APP_PASSWORD=change-me-app

# MinIO（asset の置き先）。R2 を使う時は compose の minio を消して ASSET_* を直接書く
MINIO_ROOT_USER=cms
MINIO_ROOT_PASSWORD=change-me-too
ASSET_BUCKET=cms
# 画像の配信 URL の前置き。Caddy なら https://assets.example.com/cms、Tunnel なら Cloudflare 側で minio:9000 に向けた hostname
ASSET_PUBLIC_URL=https://assets.example.com/cms

# 管理画面と公開サイトのオリジン（カンマ区切り）。空なら CORS 無し
CMS_CORS_ORIGINS=https://admin.example.com,https://www.example.com

# profile caddy を使う時
CMS_DOMAIN=cms.example.com
ASSET_DOMAIN=assets.example.com

# profile alloy を使う時（Grafana Cloud の Loki の接続先）
GRAFANA_LOKI_URL=https://logs-prod-xxx.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=123456
GRAFANA_API_KEY=glc_...

# 認証。Cloudflare Access の例。dev は手元だけ（CMS_VERSION=dev のイメージでしか起動しない）
CMS_AUTH=jwks
CMS_AUTH_ISSUER=https://your-team.cloudflareaccess.com
CMS_AUTH_JWKS_URL=https://your-team.cloudflareaccess.com/cdn-cgi/access/certs
CMS_AUTH_AUDIENCE=<Access アプリの Application Audience (AUD) Tag>
CMS_BOOTSTRAP_OWNER=you@example.com
# 公開 API の鍵のハッシュに混ぜる秘密。長い乱数にする
CMS_API_KEY_PEPPER=change-me-long-random
# セルフホストで 1 プロジェクトなら default のまま。他人も使うクラウド版は空にして、プロジェクト slug 無しを 404 にする
CMS_DEFAULT_PROJECT=default
# 見知らぬ人に組織を作らせないなら closed
CMS_SIGNUP=closed
# 外の cron から POST /jobs/tick を叩く時の合言葉（保険。無ければその口は閉じる）
CMS_JOBS_TOKEN=
# ログの最低 severity。debug にすると /health の行も出る
CMS_LOG_LEVEL=info

# CDN の purge（任意）。両方入れると、公開などで版が進んだプロジェクトの purge_everything を tick が送る（deploy/cloudflare-cache-rules.md）
CMS_CDN_PURGE_URL=
CMS_CDN_PURGE_TOKEN=
