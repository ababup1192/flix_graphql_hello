# Cloudflare Tunnel を使わない時の入口。TLS は Let's Encrypt で自動。
# {$CMS_DOMAIN} は API、{$ASSET_DOMAIN} は MinIO の画像配信（バケットは匿名の読み取りだけ）。
# サブドメインでプロジェクトを分ける（{slug}.{$CMS_DOMAIN}）のは認証の段で足す。
#
# 管理画面のホスト（Access の内側。docs/design/admin-ui-spec.md 13.2）で admin-ui/dist を配る時は、
# GraphiQL の URL を別の入口の静的ファイルに読み替える。`/p` の残りは index.html の SPA fallback。
#   @graphiql path_regexp graphiql ^/p/([^/]+)/graphiql/?$
#   rewrite @graphiql /graphiql.html?project={re.graphiql.1}

# 管理画面のホスト（docs/design/admin-ui-spec.md 13.2）で静的配信の前に import する。
# コンテンツ API のリファレンス `/p/{slug}/docs` は admin-ui の別の入口 `docs.html` で、slug は query で渡す。
(admin_docs) {
	@docs path_regexp docs ^/p/([^/]+)/docs/?$
	rewrite @docs /docs.html?project={re.docs.1}
}

{$CMS_DOMAIN} {
	encode zstd gzip
	# コンテンツ API の GET は cms が Cache-Control / ETag / Vary を決める（docs/design/cdn.md）。
	# reverse_proxy は上流のヘッダをそのまま通すので、ここで Cache-Control を上書き・削除しない。
	# 前段に Cloudflare を置くなら cache rule（deploy/cloudflare-cache-rules.md）で GET /graphql を cache eligible にする。
	# WhyNot: Caddy 自身のキャッシュ（cache-handler）を使わないのは、鍵付きの応答は no-store で弾けるが Vary の扱いが
	# モジュールごとに違い、Cloudflare と二重に持つと purge の相手が 2 つになるため。
	reverse_proxy cms:8080
}

{$ASSET_DOMAIN} {
	encode zstd gzip
	header Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy minio:9000
}
